# Salin file ini menjadi ".env" lalu isi SECRET_KEY dan MONGO_URI.
# Panduan lengkap ada di README.md.

# development = mode belajar/lokal. Ubah ke production hanya jika di-deploy.
FLASK_ENV=development

# Kunci rahasia untuk menandatangani sesi login. WAJIB diisi.
# Cara membuat: py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Alamat koneksi MongoDB Atlas. WAJIB diisi.
# Contoh bentuknya: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
MONGO_URI=

# Nama database (boleh dibiarkan seperti ini)
DATABASE_NAME=smart_expiry_db

# Ukuran maksimum satu kiriman (termasuk unggahan CSV) dalam byte: 2 MB
MAX_CONTENT_LENGTH=2097152

# Ubah ke True hanya jika aplikasi berjalan lewat HTTPS (saat deploy)
SESSION_COOKIE_SECURE=False
